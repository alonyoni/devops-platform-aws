# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012

# Project
PROJECT_NAME=devops-platform
ENVIRONMENT=dev

# EKS
EKS_CLUSTER_NAME=devops-platform-dev

# ECR
ECR_REGISTRY=${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com
ECR_REPO_NAME=devops-platform/app

# Jenkins
JENKINS_ADMIN_USER=admin
JENKINS_GITHUB_CREDENTIALS_ID=github-credentials
JENKINS_ECR_CREDENTIALS_ID=ecr-credentials

# ArgoCD
ARGOCD_GITOPS_REPO=https://github.com/your-org/devops-platform-gitops
ARGOCD_NAMESPACE=argocd

# Monitoring
GRAFANA_ADMIN_PASSWORD=changeme-in-production
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url
ALERT_EMAIL=alerts@your-org.com

# App
APP_IMAGE_TAG=latest
APP_REPLICAS=2
