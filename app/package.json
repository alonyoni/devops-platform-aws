{
  "name": "devops-platform-app",
  "version": "1.0.0",
  "description": "Sample application demonstrating the full DevOps platform CI/CD pipeline",
  "main": "src/index.js",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest --coverage --testResultsProcessor=jest-junit",
    "test:ci": "jest --coverage --watchAll=false --ci --forceExit",
    "lint": "eslint src/ --ext .js",
    "lint:fix": "eslint src/ --ext .js --fix"
  },
  "dependencies": {
    "express": "4.18.3",
    "prom-client": "15.1.2"
  },
  "devDependencies": {
    "eslint": "8.57.0",
    "jest": "29.7.0",
    "jest-junit": "16.0.0",
    "nodemon": "3.1.0",
    "supertest": "7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/**/*.test.js"
    ],
    "coverageReporters": ["text", "lcov", "json-summary"],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    },
    "testResultsProcessor": "jest-junit"
  },
  "jest-junit": {
    "outputDirectory": "test-results",
    "outputName": "junit.xml",
    "classNameTemplate": "{classname}",
    "titleTemplate": "{title}",
    "ancestorSeparator": " › "
  }
}
